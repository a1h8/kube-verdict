{
  "replicaCount": 1,
  "image": {
    "repository": "ghcr.io/acme/api",
    "tag": "v4.1.0",
    "pullPolicy": "IfNotPresent"
  },
  "resources": {
    "limits": {
      "memory": "256Mi",
      "cpu": "1"
    },
    "requests": {
      "memory": "128Mi",
      "cpu": "250m"
    }
  },
  "service": {
    "type": "ClusterIP",
    "port": 8080
  }
}
